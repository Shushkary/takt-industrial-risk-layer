# Пример переменных окружения ТАКТ API. Скопируйте в .env и задайте значения.
# Подробности — README.md (раздел про конфигурацию).

# TAKT_PROFILE=dev        # единственный поддерживаемый сценарий старта без TAKT_API_KEY при TAKT_AUTH_REQUIRED
# TAKT_ALLOW_INTERNAL_WEBHOOK=  # при TAKT_PROFILE=airgap и prod SIEM — разрешить исходящий webhook в RFC1918 (сегмент)
# TAKT_TRUSTED_PROXY_CIDRS=
# TAKT_MTLS_DN_HEADER=
# TAKT_SECURITY_LOG_FILE=
# TAKT_CONFIG=
# TAKT_STORAGE=
# TAKT_SQLITE_PATH=
# TAKT_SQLITE_BUSY_TIMEOUT_MS=
# TAKT_API_KEY=
# TAKT_CORS_ORIGINS=
# TAKT_HSTS_MAX_AGE=
# TAKT_HSTS_PRELOAD=
# TAKT_LOG_LEVEL=INFO
# TAKT_REQUEST_ID_HEADER=
# TAKT_SLOW_REQUEST_LOG_SEC=
# TAKT_MAX_REQUEST_BODY_MB=
# TAKT_RATE_LIMIT_PER_MIN=
# TAKT_RATE_LIMIT_MAX_IPS=
# TAKT_RATE_LIMIT_IP_HEADER=
# TAKT_CATALOG_CACHE_MAX_AGE_SEC=
# TAKT_IDEMPOTENCY_TTL_SEC=86400
# TAKT_OPENAPI_SERVER_URL=
# TAKT_BUILD_REVISION=
