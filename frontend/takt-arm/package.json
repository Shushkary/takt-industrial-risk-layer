{
  "name": "takt-arm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check:workspace-boundary": "node scripts/check-workspace-boundary.mjs",
    "check:api-client": "node scripts/check-api-client-contract.mjs",
    "test:unit:contracts": "node scripts/run-unit-tests.mjs",
    "test:unit:vitest": "vitest run",
    "test:unit": "npm run test:unit:contracts && npm run test:unit:vitest",
    "test:e2e:smoke": "node scripts/run-e2e-smoke.mjs",
    "test:e2e:playwright": "playwright test",
    "test:e2e": "npm run test:e2e:smoke && npm run test:e2e:playwright",
    "sbom:frontend": "node scripts/generate-frontend-sbom.mjs",
    "check:release-artifacts": "node scripts/check-frontend-release-artifacts.mjs",
    "audit:frontend": "npm audit --omit=dev --audit-level=high",
    "test:frontend": "npm run check:workspace-boundary && npm run check:api-client && npm run test:unit && npm run build && npm run sbom:frontend && npm run test:e2e && npm run check:release-artifacts",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "lucide-react": "^1.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.0",
    "zod": "4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-onboarding": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "postcss": "^8.5.14",
    "storybook": "^8.6.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.7"
  }
}
