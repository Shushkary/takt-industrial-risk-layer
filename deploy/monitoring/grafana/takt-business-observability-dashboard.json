        {
          "expr": "histogram_quantile(0.95, sum(rate(takt_business_case_to_decision_seconds_bucket[1h])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "title": "Case-to-Decision Time",
      "type": "timeseries"
