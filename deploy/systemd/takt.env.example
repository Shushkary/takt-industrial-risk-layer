# Переменные окружения служб ТАКТ. Копия кладётся в /etc/takt/takt.env и читается ОБОИМИ
# юнитами: takt-api.service и takt-assembly-worker.service. Разные файлы для них означают
# разные TAKT_CONFIG или TAKT_SQLITE_PATH — приём копит сигналы в одной базе, а сборка ждёт
# их в другой.
#
# Права: 0640, владелец root, группа takt — здесь лежат ключи API.
# Полный список переменных: docs/configuration.md.

# --- хранилище ---------------------------------------------------------------
# Сборка инцидента ищет события по сущностям, поэтому постоянное хранилище обязательно:
# при memory сборка не подключается вовсе.
TAKT_STORAGE=sqlite
TAKT_SQLITE_PATH=/opt/takt/data/takt_cases.db

# Конфигурация весов, порогов и режима сборки (incident_assembly.mode).
TAKT_CONFIG=/opt/takt/config/risk_weights.yaml

# --- доступ ------------------------------------------------------------------
# Оставьте включённым: при TAKT_AUTH_REQUIRED=true и пустом ключе процесс не поднимется,
# и это правильное поведение для боевого контура.
TAKT_AUTH_REQUIRED=true
# Заполните перед первым запуском. Именованные ключи с ролями — TAKT_API_KEYS,
# см. docs/pt_techlab/rbac_matrix.md.
TAKT_API_KEY=

TAKT_SECURITY_PROFILE=prod
TAKT_LOG_LEVEL=INFO

# --- подпись доказательного пакета -------------------------------------------
# mvp — HMAC (TAKT_FORENSIC_HMAC_SECRET); gost_strict — только внешний сервис подписи,
# без HMAC-fallback. ТАКТ не является СКЗИ: подпись выполняет внешний сертифицированный
# сервис (docs/product_boundary.md).
TAKT_FORENSIC_CRYPTO_MODE=mvp
TAKT_FORENSIC_HMAC_SECRET=
# Для gost_strict обязательны оба адреса:
# TAKT_FORENSIC_SIGN_URL=
# TAKT_FORENSIC_VERIFY_URL=

# --- необязательное ----------------------------------------------------------
# TAKT_METRICS=1
# TAKT_BUILD_REVISION=
# TAKT_TRUSTED_PROXIES=127.0.0.1/32
