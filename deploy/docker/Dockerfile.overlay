# Обновление кода поверх уже собранного образа.
#
# Почему не полная сборка: с боевой ВМ закрыт выход наружу — недоступны ни registry, ни pypi.
# Установить зависимости заново там нельзя, поэтому обновляется только то, что зависимостей не
# требует: `src/`, `config/` и метаданные пакета. `PYTHONPATH=/app/src` в базовом образе ставит
# исходную раскладку впереди установленной копии, так что скопированного достаточно.
#
# Базовый образ — тег `takt-risk-layer:base`, который выкладка переставляет на последний
# успешно поднятый образ (см. README.md рядом). Раньше здесь стоял конкретный тег `d816f4e`,
# и когда его вычистили с ВМ вручную, сборка молча пошла за ним в Docker Hub и упала по
# таймауту DNS. Плавающий тег держится локально и переживает чистку остальных.
ARG BASE=takt-risk-layer:base
FROM ${BASE}

# Ревизия попадает и в метку образа, и в переменную окружения: по ней `GET /health` отвечает
# `build_revision`, и видно, из какого коммита собрано то, что сейчас работает.
ARG TAKT_BUILD_REVISION=
LABEL org.opencontainers.image.revision="${TAKT_BUILD_REVISION}"
ENV TAKT_BUILD_REVISION=${TAKT_BUILD_REVISION}

COPY src /app/src
COPY config /app/config
COPY pyproject.toml README.md /app/
